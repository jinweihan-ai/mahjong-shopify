        "custom_information_wwFfqr": {
          "type": "custom_information",
          "settings": {
            "icon": "",
            "show_as_benefit": false,
            "color_icon": "#232323",
            "icon_size": 44,
            "icon_background_size": 60,
            "text": "Design & Craft",
            "color_title": "#406049",
            "text_description": "Inspired by Monet's garden, this set brings soft florals, coral-orange backs, and a complete American mahjong tile system into one gift-ready box.\n\nSet Includes:\n. 160 American mahjong tiles\n. Zippered storage pouch\n. 4 quick reference cards\n. Instruction booklet\n. Gift-ready packaging\n\nTile Breakdown:\n. Dots, Bams, and Craks, 1-9, 4 of each = 108 tiles\n. East, South, West, and North Winds, 4 of each = 16 tiles\n. Red, Green, and White Dragons, 4 of each = 12 tiles\n. Flowers = 8 tiles\n. Jokers = 10 tiles\n. Blank spare tiles = 6 tiles\n. Total = 160 tiles\n\nTile Size:\n. Each tile: 0.87 in W x 0.6 in D x 1.25 in H\n\nA complete American mahjong set made for gathering, gifting, and keeping close.",
            "color_des": "#406049",
            "fontsize_text": 13,
            "content_popup": "",
            "spacing_top": 0,
            "spacing_bottom": 12
          }
        }
