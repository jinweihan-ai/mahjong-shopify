<style>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter:wght@300;400;500&display=swap');
.av-spring{width:100%;height:100vh;display:flex;flex-direction:column}
.av-nl{background:#D4D5C5;text-align:center;padding:10px 0;font-family:'Inter',sans-serif;font-size:11px;color:#050505;letter-spacing:.2px}
.av-sb{position:relative;flex:1;overflow:hidden;text-decoration:none;color:inherit;display:block}
.av-sb img{width:100%;height:100%;object-fit:cover;display:block}
.av-so{position:absolute;top:0;left:0;right:0;bottom:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(0,0,0,.15)}
.av-so h1{font-family:'Cormorant Garamond',serif;font-size:52px;font-weight:400;font-style:italic;color:#fff;margin-bottom:24px;text-shadow:0 2px 10px rgba(0,0,0,.2)}
.av-sbtn{display:inline-block;padding:14px 32px;background:#7A7A5D;color:#fff;font-family:'Inter',sans-serif;font-size:11px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;text-decoration:none;border:none;cursor:pointer;transition:all .3s}
.av-sbtn:hover{background:#6a6a4d}
@media(max-width:749px){
.av-nl{font-size:10px;padding:8px 16px}
.av-spring{height:auto}
.av-sb{height:var(--av-mobile-h);flex:none}
.av-so h1{font-size:36px}
.av-sbtn{padding:12px 28px;font-size:10px}
}
</style>
<div class="av-spring" style="--av-mobile-h:{{ section.settings.mobile_height }}vh">
<a href="/products/monets-garden" class="av-sb">
<img src="{{ section.settings.image | image_url: width: 2000 }}" alt="Spring garden" loading="eager">
<div class="av-so"><h1>{{ section.settings.heading | default: 'A softer spring.' | escape }}</h1><span class="av-sbtn">Shop New Arrivals</span></div>
</a></div>
{% schema %}
{
  "name": "Spring Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "A softer spring." },
    {"type": "image_picker", "id": "image", "label": "Banner Image"},
    {"type": "range", "id": "mobile_height", "label": "Mobile Banner Height (vh)", "min": 50, "max": 200, "step": 5, "default": 130, "unit": "vh"}
  ]
}
{% endschema %}
